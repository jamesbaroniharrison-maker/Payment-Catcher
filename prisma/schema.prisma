// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  stripeConnection StripeConnection?
  platformCustomer PlatformCustomer?
}

model PlatformCustomer {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  stripeCustomerId       String   @unique
  defaultPaymentMethodId String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices BillingInvoice[]
}

enum BillingInvoiceStatus {
  PENDING
  PAID
  FAILED
}

model BillingInvoice {
  id                     String               @id @default(cuid())
  platformCustomerId     String
  periodStart            DateTime
  periodEnd              DateTime
  recoveredCents         Int
  feeCents               Int
  stripePaymentIntentId  String?
  status                 BillingInvoiceStatus @default(PENDING)
  failureMessage         String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  platformCustomer PlatformCustomer @relation(fields: [platformCustomerId], references: [id], onDelete: Cascade)

  @@unique([platformCustomerId, periodStart])
}

model StripeConnection {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  stripeAccountId        String
  accountName            String?
  encryptedApiKey        String
  encryptedWebhookSecret String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookEvents  StripeWebhookEvent[]
  failedPayments FailedPayment[]
}

model StripeWebhookEvent {
  id           String   @id
  connectionId String
  type         String
  receivedAt   DateTime @default(now())

  connection StripeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

enum RetryStrategy {
  IMMEDIATE_RETRY
  WAIT_AND_EMAIL
}

enum FailedPaymentStatus {
  OPEN
  RECOVERING
  RECOVERED
  ABANDONED
}

model FailedPayment {
  id               String              @id @default(cuid())
  connectionId     String
  stripeObjectId   String
  stripeCustomerId String?
  customerEmail    String?
  amountCents      Int
  currency         String
  declineCode      String?
  failureMessage   String?
  retryStrategy    RetryStrategy
  status           FailedPaymentStatus @default(OPEN)
  lastRetryAt      DateTime?
  day1EmailSentAt  DateTime?
  day3EmailSentAt  DateTime?
  finalEmailSentAt DateTime?
  recoveredAt      DateTime?
  recoveredCents   Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  connection StripeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, stripeObjectId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
